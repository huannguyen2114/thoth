{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/design/hearth",
      "!**/.next",
      "!**/drizzle/meta",
      "!packages/ui/src/styles/tokens.css",
      "!packages/ui/src/styles/theme.css",
      "!packages/ui/src/styles/components.css"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error" },
      "suspicious": { "noExplicitAny": "error" }
    },
    "domains": { "next": "recommended", "react": "recommended" }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/**"],
      "linter": { "rules": { "correctness": { "usePlaywrightValidDescribeCallback": "off" } } }
    }
  ]
}
