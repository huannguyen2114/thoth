{
  "name": "thoth",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@thoth/web",
    "start:lan": "node apps/web/scripts/lan-server.mjs",
    "desktop:dev": "pnpm --filter @thoth/desktop dev",
    "desktop:build": "pnpm --filter @thoth/desktop build:app",
    "site:dev": "pnpm --filter @thoth/site dev",
    "site:build": "pnpm --filter @thoth/site build",
    "site:shots": "pnpm --filter @thoth/web exec playwright test --config playwright.shots.config.ts",
    "site:check": "pnpm --filter @thoth/site check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @thoth/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
